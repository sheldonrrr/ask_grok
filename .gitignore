# Ask AI Plugin — public GitHub repo
#
# Policy:
#   TRACK  = needed for contributors, CI agents, README, or release notes
#   IGNORE = local secrets, caches, IDE junk, build outputs
#   PACK   = scripts/package.sh decides the calibre plugin zip (see notes at bottom)
#
# Do not put secrets here “temporarily”. .env is ignored; use .env.example only.

# --- Secrets / local env ---
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/

# --- Python caches / test / type junk ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.egg-info/
.eggs/
*.egg

# --- Release zip artifacts (keep empty dist/ in git) ---
# Canonical name: dist/Ask_AI_Plugin_vX.Y.Z.zip  (see scripts/package.sh)
dist/*
!dist/.gitkeep
*.zip

# --- Local / native helper binaries (not source) ---
lib/bin/

# --- Backend (separate repository, if present locally) ---
backend/

# --- Editors / AI tooling ---
.idea/
.vscode/
*.code-workspace
.windsurf/
.claude/
.codex/
.agent/
.history/
.obsidian/
.sync/

# Cursor: ignore local junk; keep shared slash-commands + rules tracked
.cursor/*
!.cursor/commands/
!.cursor/commands/**
!.cursor/rules/
!.cursor/rules/**
.cursor/**/*.log

# --- OS junk ---
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
*.icloud
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo

# --- Optional local Node tooling ---
node_modules/

# --- Packaging notes (NOT git-ignore) ---
# Tracked in this public repo, but omitted from the plugin zip by scripts/package.sh:
#   release/          — MobileRead / GitHub changelog (latest only)
#   aiprovider/       — provider reference docs for contributors
#   scripts/ tests/ bin/ — packaging + caldbg + unit tests
#   .cursor/commands .cursor/rules — shared agent workflows
#   .github/          — GitHub metadata
#   setup.py requirements.txt AGENTS.md — project/dev metadata
#   ask_ai_plugin_gif_preview.gif — README preview asset (not needed inside calibre)
#   tutorial/about.md — author notes (tutorial_v1.0.md IS shipped)
#
# Vendored wheels metadata (lib/**/*.dist-info/) ARE tracked and ARE packed so
# third-party LICENSE/METADATA ship with the plugin.
